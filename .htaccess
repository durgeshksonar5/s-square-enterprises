# Apache / Hostinger / LiteSpeed Configuration for S-Square Enterprises
# Canonical Target Domain: https://www.ssquareent.com/

# ----------------------------------------------------------
# Force HTTPS + WWW Canonical Redirection
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect non-WWW (ssquareent.com) directly to WWW (https://www.ssquareent.com)
    RewriteCond %{HTTP_HOST} ^ssquareent\.com [NC]
    RewriteRule ^(.*)$ https://www.ssquareent.com/$1 [L,R=301,NE]

    # 2. Force HTTPS if accessed via HTTP with www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
    RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"'
    RewriteCond %{HTTP_HOST} ^www\.ssquareent\.com [NC]
    RewriteRule ^(.*)$ https://www.ssquareent.com/$1 [L,R=301,NE]
</IfModule>

# ----------------------------------------------------------
# Enable Gzip / Deflate Compression
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
# Enable Browser Caching / Expires Headers
# ----------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images & WebP
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
# Security & Performance Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
